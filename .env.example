# ---------- PayPal (sandbox) ----------
# Leave PAYPAL_CLIENT_ID empty to run in MOCK mode (no PayPal needed, good for a first try).
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_BASE=https://api-m.sandbox.paypal.com
# Email of your sandbox BUSINESS account (looks like sb-xxxx@business.example.com)
MERCHANT_EMAIL=
# Force mock mode even if keys exist: 1 = mock
PAYPAL_MOCK=0

# ---------- AI ----------
# LLM_PROVIDER = anthropic | openai | mock
#   anthropic -> Claude API (needs ANTHROPIC_API_KEY)
#   openai    -> ANY OpenAI-compatible API (OpenAI, Groq, Gemini's compatible endpoint, Nebius, ...)
#   mock      -> built-in rule-based fallback (no key needed)
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---------- App ----------
DB_PATH=data/settle.db
PUBLIC_BASE_URL=http://localhost:8000
